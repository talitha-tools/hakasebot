{
	"name": "@hakasebot/web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "vite build",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply hakasebot --local",
		"db:migrate:remote": "wrangler d1 migrations apply hakasebot --remote",
		"deploy": "bun run build && wrangler deploy",
		"dev": "vite dev --port 47821",
		"generate": "bun run --parallel i18n:compile cf-typegen routes:generate",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --output-structure message-modules --emit-ts-declarations --is-server 'import.meta.env.SSR'",
		"prebuild": "bun run generate",
		"predev": "bun run generate",
		"prepreview": "bun run generate",
		"pretest": "bun run generate",
		"preview": "vite preview",
		"routes:generate": "tsr generate",
		"test": "vitest run"
	},
	"dependencies": {
		"@fontsource/comic-neue": "^5.3.0",
		"@hakasebot/core": "workspace:*",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "0.10.12",
		"@tanstack/react-query": "5.102.8",
		"@tanstack/react-query-devtools": "5.102.8",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-router-ssr-query": "1.167.2",
		"@tanstack/react-start": "1.168.49",
		"better-auth": "^1.7.4",
		"drizzle-orm": "catalog:",
		"lucide-react": "^1.44.0",
		"react": "^19.3.0",
		"react-aria-components": "^1.21.1",
		"react-dom": "^19.3.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.7",
		"@hakasebot/test-kit": "workspace:*",
		"@inlang/paraglide-js": "^2.25.1",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/router-cli": "1.167.33",
		"@types/bun": "catalog:",
		"@types/libsodium-wrappers": "catalog:",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.10",
		"libsodium-wrappers": "catalog:",
		"vite": "8.3.0",
		"vitest": "catalog:",
		"wrangler": "^4.131.0"
	}
}
