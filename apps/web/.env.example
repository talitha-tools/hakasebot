# Public Lab URL, source repo, and published refs (client). Forks re-point these
# without code edits. Vite inlines VITE_* at build time.
VITE_LAB_URL=http://localhost:47821
VITE_SOURCE_REPO_URL=https://github.com/talitha-tools/hakasebot
VITE_ACTION_REF=talitha-tools/hakasebot@main

# Hosted bot App credentials (server). The Deployment holds these.
# One GitHub App: Lab sign-in (Client ID / Client secret) and the Bot
# (Client ID / PEM / slug / webhook). JWT iss is the Client ID (ADR-0039).
# HOSTED_APP_SLUG is the GitHub App slug in https://github.com/apps/<slug>
# HOSTED_APP_CLIENT_ID is the App Client ID (JWT iss and OAuth). Not a secret.
# HOSTED_APP_PRIVATE_KEY must be the App's PEM from "Generate a private key"
# (-----BEGIN … PRIVATE KEY-----), not the Client secret.
# HOSTED_APP_CLIENT_SECRET is the App's OAuth Client secret
# (Callback URL {VITE_LAB_URL}/api/auth/callback/github). Do not tick
# Request user authorization during installation. Do not enable Device Flow.
# Repository permissions: Administration Read and write; Contents Read and
# write; Workflows Read and write; Actions Read and write; Issues Read and
# write; Pull requests Read and write. Account: Email addresses Read-only.
# Leave Organization permissions on No access.
HOSTED_APP_PRIVATE_KEY=
HOSTED_APP_SLUG=
HOSTED_APP_CLIENT_ID=
HOSTED_APP_CLIENT_SECRET=
# HMAC secret from the Hosted bot App webhook settings. Webhook URL is
# {VITE_LAB_URL}/api/github-webhook. Subscribe pull_request, issue_comment,
# pull_request_review_comment. GitHub Apps always receive installation and
# installation_repositories; those are not in Subscribe to events.
HOSTED_APP_WEBHOOK_SECRET=

# Host console operator token (server). When unset, /host returns 404.
# Generate a long random string; production: wrangler secret put HOST_CONSOLE_TOKEN
HOST_CONSOLE_TOKEN=

# better-auth (required for the Lab)
# Generate secret: bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET=

# Localhost-only fake User (ADR-0012). Set to 1 so Cloud Agents can open the
# Dashboard without GitHub OAuth. Off unless this request's host is loopback,
# even if VITE_LAB_URL is a public origin (ADR-0038). Never set in production.
# Optional PAT for GitHub writes: LAB_DEV_GITHUB_TOKEN (repo +
# workflow). Do not put that token in a VITE_* key.
LAB_DEV_USER=
LAB_DEV_GITHUB_TOKEN=
LAB_DEV_GITHUB_USER_ID=

# Deployment keys for the Model catalog (server). Official vendor list
# endpoints, cached in KV (ADR-0032). Optional locally: missing keys make
# that engine's picker fail and the custom-string path still works.
# Production: wrangler secret put each one.
#
# CATALOG_XAI_API_KEY needs prepaid credits on the xAI team or listing fails.
# GET /v1/models does not spend them. In console.x.ai, restrict the key to
# Chat models, the Models endpoint, and 1 token per minute. That autofilters
# the list and the key cannot run inference.
# CATALOG_ANTIGRAVITY_OAUTH is the agy OAuth JSON from the OS keyring
# (service=gemini username=antigravity). secret-tool fails on KDE
# (charset=utf8); dump with python gi.repository.Secret. Desktop agy
# does not write a token file. The Worker refreshes it and scrapes
# Antigravity models.
CATALOG_ANTHROPIC_API_KEY=
CATALOG_ANTIGRAVITY_OAUTH=
CATALOG_OPENAI_API_KEY=
CATALOG_XAI_API_KEY=
CATALOG_CURSOR_API_KEY=
