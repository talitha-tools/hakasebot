{
	"name": "hakasebot",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@types/bun": "^1.4.2",
			"@types/libsodium-wrappers": "^0.8.2",
			"drizzle-orm": "^0.45.2",
			"libsodium-wrappers": "^0.8.4",
			"vitest": "4.1.11",
			"zod": "^4.6.2"
		}
	},
	"type": "module",
	"scripts": {
		"build": "bun run web -- build",
		"cf-typegen": "bun run web -- cf-typegen",
		"db:generate": "bun run web -- db:generate",
		"db:migrate:local": "bun run web -- db:migrate:local",
		"db:migrate:remote": "bun run web -- db:migrate:remote",
		"deploy": "bun run web -- deploy",
		"dev": "bun run web -- dev",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"generate": "bun run web -- generate",
		"i18n:compile": "bun run web -- i18n:compile",
		"lint": "oxlint --fix --fix-suggestions --deny-warnings",
		"lint:ci": "oxlint --format=github --deny-warnings",
		"lint:style": "stylelint --fix \"apps/web/src/**/*.css\"",
		"lint:style:ci": "stylelint --custom-formatter @csstools/stylelint-formatter-github \"apps/web/src/**/*.css\"",
		"prepare": "husky",
		"pretest": "bun run generate",
		"pretest:coverage": "bun run generate",
		"preview": "bun run web -- preview",
		"test": "bun run test:run",
		"test:coverage": "vitest run --coverage",
		"test:run": "vitest run",
		"web": "bun run --cwd apps/web"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@commitlint/types": "^21.2.0",
		"@csstools/stylelint-formatter-github": "^2.0.0",
		"@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
		"@types/bun": "catalog:",
		"@types/node": "^22.20.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"oxlint-tsgolint": "^7.0.2001",
		"stylelint": "^17.15.0",
		"stylelint-config-clean-order": "^10.0.0",
		"stylelint-config-recommended": "^18.0.0",
		"typescript": "^6.0.3",
		"vitest": "catalog:"
	},
	"lint-staged": {
		"*": [
			"bun run lint --no-error-on-unmatched-pattern",
			"bun run format --no-error-on-unmatched-pattern"
		],
		"*.css": [
			"bun run lint:style"
		]
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.0",
			"onFail": "download"
		}
	},
	"engines": {
		"bun": "1.4.0"
	},
	"packageManager": "bun@1.4.0"
}
